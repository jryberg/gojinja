{%- macro log_to_fluentd(custname, dev_id) -%}
    logging:
      driver: fluentd
      options:
        fluentd-address: localhost:24224
        tag: "cts.{{ custname }}.{{ dev_id }}"
        labels: "device_id,customername,devicename,com.docker.compose.service"
        fluentd-async-connect: "true"
{%- endmacro -%}
{%- macro log_to_json() -%}
    logging:
      driver: "json-file"
      options:
        labels: "device_id,customername,devicename,com.docker.compose.service,fluentd_tag,container_name"
{%- endmacro -%}
{%- macro container_footer(name) -%}
    labels:
      customername: "{{ customername }}"
      devicename: "{{ devicename }}"
      device_id: "{{ device_id }}"
      fluentd_tag: "cts.{{ customername }}.{{ device_id }}"
      container_name: "/{{ name }}"
{%- if 'containers' in template and 'fluent-kinesis' in template['containers'] and 'enabled' in template['containers']['fluent-kinesis'] and template['containers']['fluent-kinesis']['enabled']|upper == "TRUE" -%}
  {%- if 'mode' in template['containers']['fluent-kinesis'] and template['containers']['fluent-kinesis']['mode']|upper == "JSON" %}
    {{ log_to_json() }}
  {% else %}
    {{ log_to_fluentd(customername, device_id) }}
  {% endif %}
{%- else %}
    {{ log_to_json() }}
{%- endif %}
{%- endmacro -%}
{%- macro define_networks() -%}
{%- set networks = [] -%}
{%- if 'containers' in template -%}
  {%- for container, items in template['containers'].items() -%}
    {%- if 'networks' in items and items['networks']|length > 0 -%}
      {%- for network in items['networks'] -%}
{%- do networks.append(network) -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if networks|length > 0 %}
networks:
  {%- for network in networks|unique|sort %}
  {{ network }}:
    {%- if 'networks' in template -%}
      {%- if network in template['networks'] -%}
        {%- if 'driver_opts' in template['networks'][network] -%}
          {%- set driver_opts = template['networks'][network]['driver_opts'] -%}
          {%- if driver_opts|length >0 %}
    driver_opts:
            {%- for k,v in driver_opts.items() %}
      {{ k }}: {{ v }}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
        {%- if 'driver' in template['networks'][network] -%}
    driver: {{ template['networks'][network]['driver'] }}
        {%- else %}
    driver: bridge
        {%- endif -%}
      {%- endif -%}
    {%- else %}
    driver: bridge
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- endmacro -%}
services:
{%- if 'containers' in template -%}
  {%- for container, items in template['containers'].items()|sort -%}
    {%- if not ('manager' == container or 'fluent-kinesis' == container) %}
  {{ container }}:
    image: {{ items['image'] }}:{{ items['tag'] }}
    container_name: {{ container }}
    {{ get_entrypoint(container) }}
    {{ get_command(container) }}
    {{ get_restart(container) }}
    {{ get_hostname(container) }}
    {{ get_privileged(container) }}
    {{ get_networks(container) }}
    {{ get_cap_add(container) }}
    {{ get_ulimits(container) }}
    {{ get_extra_hosts(container) }}
    {{ get_environments(container) }}
    {{ get_ports(container) }}
    {{ get_depends_on(container) }}
    {{ get_links(container) }}
    {{ get_devices(container) }}
    {{ get_volumes(container) }}
    {{ container_footer(container) }}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{{ define_networks() }}

