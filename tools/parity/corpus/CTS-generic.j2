{%- macro get_environments(name) -%}
  {%- if template -%}
    {%- if 'containers' in template -%}
      {%- if name in template['containers'] -%}
        {%- set config = template['containers'][name] -%}
        {%- if 'environments' in config and config['environments']|length > 0 -%}
    environment:
          {%- if 'telegraf' in name -%}
            {%- set names = [] -%}
            {%- for container_name in template['containers'] -%}
              {%- if container_name == "fluent-kinesis" -%}
                {%- if 'containers' in template and 'fluent-kinesis' in template['containers'] and 'enabled' in template['containers']['fluent-kinesis'] and template['containers']['fluent-kinesis']['enabled']|upper == "TRUE" -%}
                  {%- do names.append(container_name) -%}
                {%- endif -%}
              {%- else -%}
                {%- do names.append(container_name) -%}
              {%- endif -%}
            {%- endfor %}
      TELEGRAF_CONTAINERS: "{{ names|join(',') }}"
          {%- endif -%}
          {%- if 'janitor' in name -%}
            {%- set names = [] -%}
            {%- for container_name in template['containers'] -%}
              {%- if container_name == "fluent-kinesis" -%}
                {%- if 'containers' in template and 'fluent-kinesis' in template['containers'] and 'enabled' in template['containers']['fluent-kinesis'] and template['containers']['fluent-kinesis']['enabled']|upper == "TRUE" -%}
                  {%- do names.append(container_name) -%}
                {%- endif -%}
              {%- else -%}
                {%- do names.append(container_name) -%}
              {%- endif -%}
            {%- endfor %}
      JANITOR_CONTAINERS: "{{ names|join(',') }}"
          {%- endif -%}
          {%- set envs = config['environments'] -%}
          {%- for k, v in envs.items()|sort -%}
            {%- if '{{ ' in v|string and ' }}' in v|string -%}
              {# If we are here then no definition was found for the system variable, ignoring that entry #}
              {%- continue -%}
            {%- elif v|lower == 'true' or v|lower == 'false' -%}
              {# Looks like a bool, making sure we are using lower case for conformity #}
      {{ k }}: "{{ v|lower }}"
            {%- else -%}
              {# Simple key - value definition, write is as is #}
      {{ k }}: "{{ v|replace('\"','\\"') }}"
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
    # environment:
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}
