{# groupby with attribute, default, case_sensitive #}
{% for grouper, list in users|groupby('group') %}{{ grouper }}: {{ list|map(attribute='name')|join(',') }}
{% endfor %}
{# nested attribute groupby #}
{% for k, group in items|groupby('meta.k') %}{{ k }}: {{ group|map(attribute='v')|join(',') }}
{% endfor %}
